---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import MenuOverlay from '../../components/MenuOverlay.astro';
import { projects } from '../../content/site';

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.id },
    props: { project: p },
  }));
}

const { project } = Astro.props;
const nextProject = projects.find((p) => p.id === project.nextProjectId);
---

<Layout title={project.name} description={project.tagline || project.result}>
  <Header />
  <MenuOverlay />

  <main class="px-6 md:px-10 pt-28 md:pt-32 pb-24">
    <a href="/#proyectos" class="font-body text-sm text-muted underline underline-offset-4">
      ← Volver a proyectos
    </a>

    {project.hasFullCase ? (
      <article class="mt-10 max-w-5xl mx-auto">
        <header class="flex items-end justify-between gap-6 border-b border-line pb-8 mb-10">
          <h1 class="font-display text-[10vw] md:text-[4vw] leading-none max-w-[16ch]">
            {project.name}
          </h1>
          {project.brand?.accentColor && (
            <span
              class="hidden md:block h-3 w-3 rounded-full shrink-0"
              style={`background-color: ${project.brand.accentColor}; opacity: 0.5;`}
              aria-hidden="true"
            />
          )}
        </header>

        <p class="font-display text-2xl md:text-3xl max-w-[28ch] mb-12">{project.tagline}</p>

        <img src={project.cover} alt="" class="w-full rounded-lg mb-14 object-cover" />

        <dl class="grid grid-cols-2 md:grid-cols-5 gap-6 border-y border-line py-8 mb-16 font-body text-sm">
          <div><dt class="text-muted mb-1">Rol</dt><dd>{project.brand?.role}</dd></div>
          <div><dt class="text-muted mb-1">Plataforma</dt><dd>{project.brand?.platform}</dd></div>
          <div><dt class="text-muted mb-1">Equipo</dt><dd>{project.brand?.team}</dd></div>
          <div><dt class="text-muted mb-1">Timeline</dt><dd>{project.brand?.timeline}</dd></div>
          <div><dt class="text-muted mb-1">Alcance</dt><dd>{project.brand?.scope}</dd></div>
        </dl>

        <p class="font-body text-lg max-w-[60ch] mb-16">{project.intro}</p>

        <div class="flex flex-col gap-20 mb-20">
          {project.sections?.map((section, i) => (
            <div class={`grid md:grid-cols-2 gap-8 items-center ${i % 2 === 1 ? 'md:[&>*:first-child]:order-2' : ''}`}>
              <img src={section.image} alt="" class="w-full rounded-lg object-cover" />
              <div>
                <h2 class="font-display text-2xl md:text-3xl mb-3">{section.title}</h2>
                <p class="font-body text-base text-muted max-w-[42ch]">{section.body}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="border-t border-line pt-14 mb-20">
          <h2 class="font-body text-xs uppercase tracking-widest text-muted mb-8">Resultados</h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
            {project.results?.map((r) => (
              <p class="font-display text-2xl md:text-3xl leading-tight">{r}</p>
            ))}
          </div>
        </div>

        {project.gallery && project.gallery.length > 0 && (
          <div class="grid md:grid-cols-3 gap-4 mb-20">
            {project.gallery.map((src) => (
              <img src={src} alt="" class="w-full rounded-lg object-cover" />
            ))}
          </div>
        )}

        {nextProject && (
          <a
            href={`/proyecto/${nextProject.id}`}
            class="block border-t border-line pt-10 group"
          >
            <span class="font-body text-xs uppercase tracking-widest text-muted">Siguiente proyecto</span>
            <span class="font-display text-[10vw] md:text-[5vw] leading-none block mt-2 group-hover:italic transition-[font-style]">
              {nextProject.name} →
            </span>
          </a>
        )}
      </article>
    ) : (
      <article class="mt-10 max-w-3xl mx-auto text-center py-20">
        <h1 class="font-display text-[10vw] md:text-[4vw] leading-none mb-6">{project.name}</h1>
        <img src={project.cover} alt="" class="w-full rounded-lg mb-10 object-cover" />
        <p class="font-body text-base text-muted mb-2">{project.context}</p>
        <p class="font-body text-lg mb-10">Caso de estudio en redacción — vuelvo pronto con el detalle completo.</p>
        <a href="/contacto" class="chip inline-block rounded-full px-6 py-3 text-sm font-body">
          Hablemos mientras tanto
        </a>
      </article>
    )}
  </main>
</Layout>
