---
import { nav, identity } from '../content/site';
---

<div
  id="menu-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Menú de navegación"
  class="fixed inset-0 z-50 bg-bg translate-y-[-100%] opacity-0 pointer-events-none"
  data-state="closed"
>
  <div class="flex items-center justify-between px-6 md:px-10 h-16 md:h-20">
    <span class="font-display text-base md:text-lg">{identity.name}</span>
    <button
      id="menu-close"
      type="button"
      class="chip rounded-full px-4 py-2 text-xs font-body tracking-wide"
    >
      Cerrar
    </button>
  </div>

  <nav class="px-6 md:px-10 mt-10 md:mt-16">
    <ul class="flex flex-col gap-2 md:gap-4">
      {
        nav.map((item) => (
          <li class="border-b border-line">
            <a
              href={item.href}
              class="menu-link group flex items-baseline gap-4 md:gap-6 py-4 md:py-6"
            >
              <span class="font-body text-sm text-muted">{item.number}</span>
              <span class="font-display text-[13vw] md:text-[6vw] leading-none group-hover:italic transition-[font-style] duration-200">
                {item.label}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script>
  const overlay = document.getElementById('menu-overlay')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  let lastFocused: HTMLElement | null = null;

  function getFocusable(): HTMLElement[] {
    return Array.from(
      overlay.querySelectorAll<HTMLElement>(
        'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
      )
    );
  }

  function openMenu() {
    lastFocused = document.activeElement as HTMLElement;
    overlay.dataset.state = 'open';
    overlay.classList.remove('translate-y-[-100%]', 'opacity-0', 'pointer-events-none');
    overlay.classList.add('translate-y-0', 'opacity-100');
    overlay.style.transition = 'transform 500ms cubic-bezier(0.16,1,0.3,1), opacity 400ms ease';
    document.body.style.overflow = 'hidden';
    openBtn.setAttribute('aria-expanded', 'true');
    const focusable = getFocusable();
    focusable[0]?.focus();
  }

  function closeMenu() {
    overlay.dataset.state = 'closed';
    overlay.classList.add('translate-y-[-100%]', 'opacity-0', 'pointer-events-none');
    overlay.classList.remove('translate-y-0', 'opacity-100');
    document.body.style.overflow = '';
    openBtn.setAttribute('aria-expanded', 'false');
    lastFocused?.focus();
  }

  openBtn.addEventListener('click', openMenu);
  closeBtn.addEventListener('click', closeMenu);

  // Cierra al hacer click fuera del contenido (en el propio fondo del overlay)
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeMenu();
  });

  // Cierra los enlaces del menú al navegar
  overlay.querySelectorAll('.menu-link').forEach((link) => {
    link.addEventListener('click', () => closeMenu());
  });

  document.addEventListener('keydown', (e) => {
    if (overlay.dataset.state !== 'open') return;

    if (e.key === 'Escape') {
      closeMenu();
      return;
    }

    // Atrapa el foco con Tab dentro del overlay.
    if (e.key === 'Tab') {
      const focusable = getFocusable();
      if (focusable.length === 0) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });
</script>
