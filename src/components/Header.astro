---
import { identity, availability, availabilityText } from '../content/site';

const isAvailable = availability === 'available';
const label = isAvailable ? availabilityText.available.short : availabilityText.unavailable.short;
---

<header
  class="fixed top-0 inset-x-0 z-40 flex items-center justify-between px-6 md:px-10 h-16 md:h-20 bg-bg/80 backdrop-blur-sm"
>
  <a href="/" class="font-display text-base md:text-lg tracking-tight">
    {identity.name}
  </a>

  <div class="flex items-center gap-4 md:gap-6">
    <span class="hidden sm:flex items-center gap-2 text-xs text-muted font-body">
      <span
        class:list={[
          'inline-block h-1.5 w-1.5 rounded-full',
          isAvailable ? 'bg-available' : 'bg-unavailable',
        ]}
        aria-hidden="true"
      ></span>
      {label}
    </span>

    <button
      id="menu-open"
      type="button"
      class="chip rounded-full px-4 py-2 text-xs font-body tracking-wide"
      aria-haspopup="dialog"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      Menú
    </button>
  </div>
</header>
