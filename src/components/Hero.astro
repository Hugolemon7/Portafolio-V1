---
import { copy, availability, availabilityText } from '../content/site';

const isAvailable = availability === 'available';
const availLabel = isAvailable ? availabilityText.available.long : availabilityText.unavailable.long;

// TODO: sustituir por las fotos reales (ver 04-CONTENIDO > inventario de assets).
const heroPhotos = ['/images/hero/photo-1.jpg', '/images/hero/photo-2.jpg', '/images/hero/photo-3.jpg'];
---

<section
  id="inicio"
  class="scroll-section relative min-h-[100svh] flex items-center px-6 md:px-10 pt-24 md:pt-20"
>
  <p
    id="hero-sentence"
    class="font-display font-normal text-[9vw] md:text-[4.4vw] leading-[1.08] max-w-[20ch] text-left"
  >
    {copy.heroPrefix}
    {' '}
    <span id="role-word" class="relative underline decoration-1 underline-offset-8 cursor-default">
      {copy.heroRoleWord}
    </span>
    {' '}
    <span
      class="chip inline-flex items-center gap-2 rounded-full px-3 md:px-4 py-1 align-middle text-[0.32em] font-body tracking-wide"
    >
      <span
        class:list={['inline-block h-2 w-2 rounded-full', isAvailable ? 'bg-available' : 'bg-unavailable']}
        aria-hidden="true"
      ></span>
      {availLabel}
    </span>
    {' '}
    {copy.heroMiddle}
    {' '}
    <button
      id="theme-toggle"
      type="button"
      role="switch"
      aria-checked="false"
      aria-label="Cambiar a modo oscuro"
      class="chip relative inline-flex h-[0.55em] w-[1.05em] align-middle rounded-full mx-1 shrink-0"
    >
      <span
        id="theme-toggle-thumb"
        class="absolute top-[0.08em] left-[0.08em] h-[0.39em] w-[0.39em] rounded-full bg-bg transition-transform duration-300 ease-editorial"
      ></span>
    </button>
    {' '}
    {copy.heroMiddle2}
    {' '}
    <a
      href="/contacto"
      id="talk-chip"
      class="chip relative inline-flex items-center rounded-full pl-4 pr-1 py-1 align-middle text-[0.32em] font-body tracking-wide overflow-hidden"
    >
      <span>{copy.heroCta}</span>
      <span class="talk-chip-icon relative ml-2 h-[1.6em] w-[1.6em] shrink-0">
        <svg
          class="talk-chip-arrow absolute inset-0 transition-all duration-300 ease-editorial"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <span
          class="talk-chip-avatar absolute inset-0 rounded-full bg-cover bg-center opacity-0 scale-75 transition-all duration-300 ease-editorial"
          style={`background-image: url(${heroPhotos[0]})`}
          aria-hidden="true"
        ></span>
      </span>
    </a>
    {' '}
    {copy.heroCtaSuffix}
  </p>

  <!-- Foto flotante que sigue al cursor al pasar por "Product Designer". -->
  <div
    id="hero-float-photo"
    class="pointer-events-none fixed z-30 h-40 w-32 md:h-56 md:w-44 rounded-md overflow-hidden opacity-0 scale-95 transition-opacity duration-200"
    aria-hidden="true"
  >
    {heroPhotos.map((src, i) => (
      <img
        src={src}
        alt=""
        class="hero-float-img absolute inset-0 h-full w-full object-cover transition-opacity duration-300"
        style={`opacity: ${i === 0 ? 1 : 0}`}
        data-index={i}
      />
    ))}
  </div>
</section>

<script define:vars={{ photoCount: 3 }}>
  // --- Interruptor de tema (real, dentro de la frase, no en la cabecera) ---
  const toggle = document.getElementById('theme-toggle');
  const thumb = document.getElementById('theme-toggle-thumb');

  function syncToggleUI() {
    const isDark = document.documentElement.classList.contains('dark');
    toggle.setAttribute('aria-checked', String(isDark));
    toggle.setAttribute('aria-label', isDark ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro');
    thumb.style.transform = isDark ? 'translateX(0.5em)' : 'translateX(0)';
  }
  syncToggleUI();

  toggle.addEventListener('click', () => {
    const root = document.documentElement;
    const isDark = root.classList.toggle('dark');
    try {
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    } catch (e) {}
    syncToggleUI();
  });

  // --- "Product Designer": fotos que siguen al cursor y van cambiando ---
  const roleWord = document.getElementById('role-word');
  const floatPhoto = document.getElementById('hero-float-photo');
  const floatImgs = Array.from(document.querySelectorAll('.hero-float-img'));
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let cycleTimer = null;
  let currentIndex = 0;

  function positionPhoto(e) {
    const offset = 24;
    floatPhoto.style.left = `${e.clientX + offset}px`;
    floatPhoto.style.top = `${e.clientY - floatPhoto.offsetHeight / 2}px`;
  }

  function cyclePhoto() {
    const next = (currentIndex + 1) % photoCount;
    floatImgs[currentIndex].style.opacity = '0';
    floatImgs[next].style.opacity = '1';
    currentIndex = next;
  }

  if (roleWord && !reduceMotion) {
    roleWord.addEventListener('mouseenter', (e) => {
      positionPhoto(e);
      floatPhoto.classList.remove('opacity-0', 'scale-95');
      cycleTimer = window.setInterval(cyclePhoto, 900);
    });
    roleWord.addEventListener('mousemove', positionPhoto);
    roleWord.addEventListener('mouseleave', () => {
      floatPhoto.classList.add('opacity-0', 'scale-95');
      if (cycleTimer) window.clearInterval(cycleTimer);
    });
  }

  // --- "vamos a hablar": la flecha se recoge y entra el avatar, sin ---
  // --- que el chip crezca ni salte el layout. ---
  const talkChip = document.getElementById('talk-chip');
  const arrow = talkChip?.querySelector('.talk-chip-arrow');
  const avatar = talkChip?.querySelector('.talk-chip-avatar');

  talkChip?.addEventListener('mouseenter', () => {
    arrow.style.opacity = '0';
    arrow.style.transform = 'translateX(6px) scale(0.7)';
    avatar.style.opacity = '1';
    avatar.style.transform = 'scale(1)';
  });
  talkChip?.addEventListener('mouseleave', () => {
    arrow.style.opacity = '1';
    arrow.style.transform = 'translateX(0) scale(1)';
    avatar.style.opacity = '0';
    avatar.style.transform = 'scale(0.75)';
  });
</script>
